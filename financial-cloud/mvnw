#!/bin/sh
# Maven Wrapper for Unix (GitHub Actions / Linux / macOS)
set -eu

PROJECT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
WRAPPER_DIR="$PROJECT_DIR/.mvn/wrapper"
WRAPPER_JAR="$WRAPPER_DIR/maven-wrapper.jar"
WRAPPER_PROPS="$WRAPPER_DIR/maven-wrapper.properties"
JAVA_EXE="${JAVA_HOME:+$JAVA_HOME/bin/java}"
JAVA_EXE="${JAVA_EXE:-java}"

if [ ! -f "$WRAPPER_JAR" ]; then
  if [ ! -f "$WRAPPER_PROPS" ]; then
    echo "Missing $WRAPPER_PROPS" >&2
    exit 1
  fi
  WRAPPER_URL="$(sed -n 's/^wrapperUrl=//p' "$WRAPPER_PROPS" | tr -d '\r')"
  if [ -z "$WRAPPER_URL" ]; then
    WRAPPER_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"
  fi
  mkdir -p "$WRAPPER_DIR"
  echo "Downloading Maven Wrapper jar from $WRAPPER_URL"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "$WRAPPER_JAR" "$WRAPPER_URL"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$WRAPPER_JAR" "$WRAPPER_URL"
  else
    echo "curl or wget required to download maven-wrapper.jar" >&2
    exit 1
  fi
fi

exec "$JAVA_EXE" \
  -classpath "$WRAPPER_JAR" \
  "-Dmaven.multiModuleProjectDirectory=$PROJECT_DIR" \
  org.apache.maven.wrapper.MavenWrapperMain \
  "$@"
