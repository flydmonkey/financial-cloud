<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.financial.cloud.repository.permissions.AuthzMapper">

    <select id="queryRolesByMembers" parameterType="QueryGroupMembersDto" resultType="Roles">
        select distinct mg.*
        from roles mg
        join role_member mgm
        on mg.id = mgm.role_id
        where mg.status = 1
        and mg.deleted = 'n'
        and (
        role_code = 'ROLE_ALL_USER'
        or (
            <choose>
                <when test="bookId != null and bookId != ''">
                    mgm.member_id in(
                    <foreach collection="members" item="item" separator=",">
                        #{item}
                    </foreach>
                    )
                    and mgm.book_id = #{bookId}
                </when>
                <otherwise>
                    <!-- Fail-closed: no active book ⇒ no book-scoped product roles -->
                    1 = 0
                </otherwise>
            </choose>
        )
        )
    </select>
    
</mapper>
